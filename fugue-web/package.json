{
  "name": "fugue-hands",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Bach's three-voice fugue, played by your hands.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm prepare-assets && vite",
    "build": "pnpm prepare-assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare-assets": "node scripts/sync-audio.mjs && node scripts/download-model.mjs",
    "sync-audio": "node scripts/sync-audio.mjs",
    "download-model": "node scripts/download-model.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  }
}
