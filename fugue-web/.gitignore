node_modules/
dist/
.DS_Store
.vite/
*.log
# audio stems are sourced from ../data/audio at dev time, but committed here
# directly so Cloudflare/CI builds (which lack ../data/audio) succeed.
# The leading `!` overrides the root .gitignore's global `*.mp3` rule.
!public/audio/*.mp3
# MediaPipe model is fetched by scripts/download-model.mjs at dev time
public/mediapipe/*.task
